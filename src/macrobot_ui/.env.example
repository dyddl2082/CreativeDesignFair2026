# Store the real file at ~/.config/macrobot_ui/.env.
OPENAI_API_KEY=
MACROBOT_MODEL=gpt-5.6
MACROBOT_STORE_RESPONSES=false

# Optional font overrides. Leave empty for automatic Korean-capable selection.
# Recommended Ubuntu/WSL2 families after installing fonts-noto-cjk/fonts-nanum:
#   Noto Sans CJK KR
#   Noto Sans Mono CJK KR
MACROBOT_UI_FONT_FAMILY=
MACROBOT_CODE_FONT_FAMILY=

# Register known local Linux font files and, on WSL2, existing Windows Malgun
# Gothic files. No font files are bundled or copied by macrobot_ui.
MACROBOT_UI_REGISTER_SYSTEM_FONTS=true
MACROBOT_UI_USE_WINDOWS_FONTS=true

# Refuse to open a square-glyph UI when no Korean-capable font is available.
MACROBOT_UI_STRICT_FONT_CHECK=true

# WSLg Korean input method. The UI prepares these values before importing Qt.
# Use ibus for the PySide6 pip wheel; it normally bundles the Qt IBus plugin.
MACROBOT_UI_IME_BACKEND=ibus
MACROBOT_UI_IME_AUTOSTART=true
MACROBOT_UI_IME_FORCE_XCB=true
MACROBOT_UI_IME_STRICT=true
MACROBOT_UI_IME_ENGINE=hangul

# true: start MacRobot UI in Hangul mode. Set false to preserve the current IBus engine.
MACROBOT_UI_IME_AUTO_ACTIVATE=true
