<?xml version="1.0"?>
<package format="3">
  <name>macrobot_arm_kinematics</name>
  <version>0.3.0</version>
  <description>Reduced FK/IK and closed-linkage visual mapping for the MacRobot arm and gripper.</description>
  <maintainer email="dyddl2082@snu.ac.kr">Kim Jinhyeong</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
