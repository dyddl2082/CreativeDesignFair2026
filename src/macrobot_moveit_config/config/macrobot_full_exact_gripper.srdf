<?xml version="1.0"?>
<robot name="macrobot_full_exact_gripper">
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <disable_collisions link1="base_link" link2="servo_left_gear" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="servo_right_gear" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="ratio_left_gear" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="ratio_right_gear" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_left_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="back_left_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_right_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="back_right_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="ratio_right_gear" link2="back_link" reason="Adjacent"/>
  <disable_collisions link1="back_link" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="gripper_servo_gear" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="gripper_left_gear" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="gripper_right_gear" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="gripper_left_addition" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="gripper_right_addition" reason="Adjacent"/>
  <disable_collisions link1="gripper_left_addition" link2="gripper_clamp_left" reason="Adjacent"/>
  <disable_collisions link1="gripper_right_addition" link2="gripper_clamp_right" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="ratio_left_gear" link2="gripper_link" reason="FourBarClosure"/>
  <disable_collisions link1="gripper_left_gear" link2="gripper_clamp_left" reason="GripperClosure"/>
  <disable_collisions link1="gripper_right_gear" link2="gripper_clamp_right" reason="GripperClosure"/>
  <disable_collisions link1="servo_left_gear" link2="ratio_left_gear" reason="GearMesh"/>
  <disable_collisions link1="servo_right_gear" link2="ratio_right_gear" reason="GearMesh"/>
  <disable_collisions link1="gripper_servo_gear" link2="gripper_left_gear" reason="GearMesh"/>
  <disable_collisions link1="gripper_left_gear" link2="gripper_right_gear" reason="GearMesh"/>
</robot>
