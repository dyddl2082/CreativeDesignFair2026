<?xml version="1.0"?>
<robot name="macrobot_arm_kinematic">
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <group name="arm">
    <joint name="arm_lift_joint"/>
    <joint name="wrist_pitch_joint"/>
  </group>
  <group name="gripper">
    <joint name="gripper_joint"/>
  </group>
  <group name="arm_with_gripper">
    <group name="arm"/>
    <group name="gripper"/>
  </group>

  <end_effector name="macrobot_gripper" parent_link="wrist_link" group="gripper" parent_group="arm"/>

  <group_state name="home" group="arm_with_gripper">
    <joint name="arm_lift_joint" value="0"/>
    <joint name="wrist_pitch_joint" value="0"/>
    <joint name="gripper_joint" value="0"/>
  </group_state>
  <group_state name="gripper_open" group="gripper">
    <joint name="gripper_joint" value="0"/>
  </group_state>
  <group_state name="gripper_closed" group="gripper">
    <joint name="gripper_joint" value="-1.25"/>
  </group_state>

  <!-- Adjacent or deliberately overlapping simplified collision bodies. -->
  <disable_collisions link1="base_link" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="main_arm_link" reason="Adjacent"/>
  <disable_collisions link1="main_arm_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="grasp_nominal" reason="Adjacent"/>
</robot>
