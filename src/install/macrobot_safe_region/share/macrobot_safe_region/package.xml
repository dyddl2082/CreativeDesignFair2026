<?xml version="1.0"?>
<package format="3">
  <name>macrobot_safe_region</name>
  <version>0.1.0</version>
  <description>MoveIt collision and actuator-constrained safe-region generator for MacRobot.</description>
  <maintainer email="dyddl2082@snu.ac.kr">Kim Jinhyeong</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>macrobot_description</exec_depend>
  <exec_depend>macrobot_moveit_config</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
